/**
 * Configuração do Cloudflare Worker para o ENEM API
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enem-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "enem-api.prepvestibular.ia.br",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "enem-api-public",
      "database_id": "placeholder-d1-id-configurado-no-ci"
    }
  ],
  "observability": {
    "enabled": true
  }
}
