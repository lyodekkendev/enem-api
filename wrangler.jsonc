/**
 * Configuração do Cloudflare Worker para o ENEM API
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enem-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "enem-api.prepvestibular.ia.br",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "enem-api-public",
      "database_id": "6e11e71a-81f7-42d6-942d-b4dc46f14e25"
    }
  ],
  "observability": {
    "enabled": true
  }
}